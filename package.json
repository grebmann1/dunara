{
  "name": "mobile-app-builder",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.1",
  "bin": {
    "mobile-builder": "dist/packages/cli/src/index.js"
  },
  "scripts": {
    "dev": "tsx packages/cli/src/index.ts",
    "desktop": "node scripts/desktop.mjs",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:desktop:backend": "node scripts/desktop-backend-smoke.mjs",
    "test:native-workspace": "node scripts/native-workspace-smoke.mjs",
    "studio:dev": "vite apps/studio --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit && tsc -p apps/studio/tsconfig.json --noEmit",
    "lint": "eslint packages/*/src apps/studio/src tests scripts",
    "test": "vitest run",
    "build": "tsc && tsc -p packages/plugin-sdk/tsconfig.json && vite build apps/studio --emptyOutDir --outDir ../../dist/studio && node scripts/copy-assets.mjs",
    "test:e2e": "playwright test",
    "test:visual": "VISUAL=1 playwright test",
    "start": "node dist/packages/cli/src/index.js",
    "release:smoke": "node scripts/release-smoke.mjs",
    "test:desktop:secrets": "node scripts/desktop-secret-smoke.mjs",
    "test:plugin-sdk": "node scripts/plugin-sdk-smoke.mjs",
    "build:packages": "pnpm build && node scripts/build-packages.mjs",
    "test:packages": "node scripts/package-consumer-smoke.mjs",
    "source:check": "node scripts/source-safety.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-select": "2.3.7",
    "@vercel/sandbox": "3.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "e2b": "2.49.0",
    "lucide-react": "1.45.0",
    "openai": "7.15.0",
    "playwright": "1.63.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "tailwind-merge": "3.7.0",
    "typescript": "6.0.3",
    "ws": "8.21.3",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.5.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "electron": "44.4.0",
    "eslint": "10.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "optionalDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "typebox": "1.3.7"
  }
}
